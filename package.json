{
  "name": "stitchord",
  "version": "0.0.0",
  "private": true,
  "description": "Stitchord — web-based, production-grade embroidery digitizing platform",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @stitchord/web",
